{{> page-banner}}
<div class="py-12" x-data :style="'background-image: url(\'{{#if @root.options.isExport}}{{@root.options.relativeAssetPath}}_site/themes/{{manifest.theme.name}}/assets/patterns/{{else}}/_site/themes/{{manifest.theme.name}}/assets/patterns/{{/if}}' + $store.background.imageNumber + '.svg\')'">
  <div class="grid gap-6 lg:gap-12 max-w-3xl mx-auto px-6">
    {{#if collectionItems}}
      {{#each collectionItems}}
        {{> "post/partials/card" this}}
      {{/each}}
    {{/if}}
  </div>
</div>
