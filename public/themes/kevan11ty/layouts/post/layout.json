{
  "name": "Post",
  "version": "1.0.0",
  "description": "Default post layout used for articles and work entries",
  "layoutType": "item",
  "parentLayout": "base",
  "files": [
    { "path": "layout.json", "type": "manifest" },
    { "path": "index.hbs", "type": "template" },
    { "path": "partials/card.hbs", "type": "partial" },
    { "path": "partials/full.hbs", "type": "partial" }
  ],
  "partials": [
    { "path": "partials/card.hbs", "name": "Card View", "isDefault": true },
    { "path": "partials/full.hbs", "name": "Full" }
  ],
  "schema": {
    "type": "object",
    "properties": {
      "author": { "type": "string", "title": "Author" },
      "excerpt": { "type": "string", "title": "Excerpt" }
    }
  },
  "uiSchema": {
    "excerpt": { "ui:widget": "textarea" }
  }
}
