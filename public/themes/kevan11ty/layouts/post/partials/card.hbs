<div class="bg-white border border-[#000] shadow-line">
  <div class="p-6">
    <h3 class="text-xl lg:text-2xl mb-2 hover:underline font-bold">
      <a href="{{url}}">{{frontmatter.title}}</a>
    </h3>
    <p class="text-[#000] text-sm">{{frontmatter.description}}</p>
  </div>
  <div class="border-t border-[#000] flex">
    <div class="border-r border-[#000] px-6 py-4">
      <p class="meta text-xs text-[#000]">{{formatDate frontmatter.date}}</p>
    </div>
    <div class="px-4 py-3">
      {{#if resolvedTags}}
        <div class="tags">
          {{#each resolvedTags}}
            {{#each this}}
              <span class="inline-flex items-center px-2 pt-1 pb-[4px] pixel-corners-8 text-xs font-medium border-[#000]">{{this.name}}</span>
            {{/each}}
          {{/each}}
        </div>
      {{/if}}
    </div>
  </div>
</div>
