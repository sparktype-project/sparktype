<!DOCTYPE html>
<html class="classic-mono-scrollbars" lang="en">
<head>
  {{> head headContext}}
</head>
<body>
  {{> header}}
  {{{body}}}
  {{> footer}}
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  {{#if @root.options.isExport}}
    <script src="{{@root.options.relativeAssetPath}}_site/themes/{{manifest.theme.name}}/assets/scripts.js"></script>
  {{else}}
    <script src="/_site/themes/{{manifest.theme.name}}/assets/scripts.js"></script>
  {{/if}}
  <script type="module" src="https://unpkg.com/@dotlottie/player-component@latest/dist/dotlottie-player.mjs"></script>
  <script
    data-goatcounter="https://unltddreamco.goatcounter.com/count"
    async
    src="//gc.zgo.at/count.js">
  </script>
</body>
</html>
