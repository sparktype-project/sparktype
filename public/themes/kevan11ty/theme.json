  "stylesheets": [
    { "path": "styles.css", "type": "main" }
  ],
  "layouts": ["page", "post", "wide-post", "project-post", "artwork-post", "list-view"],
  "appearanceSchema": {
    "title": "Theme customisation",
    "description": "Core palette and typography",
    "type": "object",
    "properties": {
      "font_sans": {
        "type": "string",
        "title": "Primary font",
        "default": "'Neue Machina', Inter, system-ui, sans-serif"
      },
      "color_bg": {
        "type": "string",
        "title": "Background",
        "format": "color",
        "default": "#ffffff"
      },
      "color_text": {
        "type": "string",
        "title": "Text",
        "format": "color",
        "default": "#000000"
      },
      "color_border": {
        "type": "string",
        "title": "Border",
        "format": "color",
        "default": "#000000"
      }
    }
  },
  "themeDataSchema": {
    "type": "object",
    "properties": {
      "site_tagline": {
        "type": "string",
        "title": "Site tagline",
        "default": "Art, design & code"
      }
    }
  },
  "image_presets": {
    "hero": {
      "width": 1600,
      "height": 900,
      "crop": "fill",
      "gravity": "center"
    },
    "card": {
      "width": 900,
      "height": 500,
      "crop": "fill",
      "gravity": "center"
    },
    "logo": {
      "width": 200,
      "height": 200,
      "crop": "fit",
      "gravity": "center"
    }
  }
}
