{{!
  Partial for a single blog post card using SparkType Design System utilities.
  'this' refers to one item from the `collectionItems` array.
}}
<article class="pb-6 grid grid-cols-3 gap-6">
    {{#if this.frontmatter.featured_image}}
        <a href="{{this.url}}" class="block mb-6">
            {{{image
                fieldname="featured_image"
                preset="thumbnail"
                alt=this.frontmatter.title
                class="w-full"
            }}}
        </a>
    {{/if}}

    <div class=" col-span-2">
        <h2 class="text-2xl mt-0 mb-2 leading-tight">
            <a
                href="{{this.url}}"
                class="no-underline hover:underline font-bold"
            >
                {{this.frontmatter.title}}
            </a>
        </h2>

        

        {{#if this.frontmatter.description}}
            <p class="text-text mt-0 mb-3 text-lg flex-1 leading-relaxed">
                {{this.frontmatter.description}}
            </p>
        {{/if}}

        <div class="flex gap-2 text-gray-400 items-center">

 {{#if this.resolvedTags }}
            <p class="meta text-sm  font-headings text-gray-400! flex flex-row gap-2 items-center">
            
                {{#each this.resolvedTags}}
                    {{#each this}}
                        <span class="inline-flex items-center ">
                            #{{this.name}}
                        </span>
                    {{/each}}
                {{/each}}
            </p>
            •
        {{/if}}
        <p class="text-gray-400! font-headings text-sm">
            {{formatDate this.frontmatter.date}} 
        </p>


        </div>

    </div>
</article>