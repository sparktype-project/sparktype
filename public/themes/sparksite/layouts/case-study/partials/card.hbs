{{!
  Partial for a single blog post card using SparkType Design System utilities.
  'this' refers to one item from the `collectionItems` array.
}}
<article class="pb-6">
    {{#if this.frontmatter.featured_image}}
        <a href="{{this.url}}" class="block mb-6">
            {{{image
                fieldname="featured_image"
                preset="thumbnail"
                alt=this.frontmatter.title
                class="w-full"
            }}}
        </a>
    {{/if}}

    <div class="">
        <h2 class="text-2xl mt-0 mb-2 leading-tight">
            <a
                href="{{this.url}}"
                class="hover:underline"
            >
                {{this.frontmatter.title}}
            </a>
        </h2>

        

        {{#if this.frontmatter.description}}
            <p class="text-text mt-0 mb-4 text-lg flex-1">
                {{this.frontmatter.description}}
            </p>
        {{/if}}

        {{#if this.resolvedTags }}
            <div class="flex flex-wrap gap-2 mb-4">
                {{#each this.resolvedTags}}
                    {{#each this}}
                        <span class="inline-flex items-center px-3 py-1 text-sm bg-slate-100 text-text rounded-full hover:bg-muted/80 transition-colors">
                            {{this.name}}
                        </span>
                    {{/each}}
                {{/each}}
            </div>
        {{/if}}

        
    </div>
</article>