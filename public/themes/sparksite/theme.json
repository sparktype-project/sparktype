{
  "name": "Sparktype theme",
  "version": "2.0.0",
  "files": [
    { "path": "theme.json", "type": "manifest" },
    { "path": "base.hbs", "type": "base" },
    { "path": "font-faces.css", "type": "stylesheet" },
    { "path": "styles.css", "type": "stylesheet" },
    { "path": "partials/head.hbs", "type": "partial", "name": "head" },
    { "path": "partials/header.hbs", "type": "partial", "name": "header" },
    { "path": "partials/footer.hbs", "type": "partial", "name": "footer" }
  ],
  "stylesheets": [
    { "path": "font-faces.css", "type": "addon" },
    { "path": "styles.css", "type": "main" }
  ],
  "layouts": ["page", "hero-page", "blog-post", "list-view", "case-study", "grid-view"],
  "appearanceSchema": {
    "title": "Theme customisation",
    "description": "Customise the core fonts and colors of your site.",
    "type": "object",
    "properties": {
      "--color-background": {
        "type": "string",
        "title": "Page background colour",
        "format": "color",
        "default": "#f8f9fa"
      },
      "--color-text": {
        "type": "string",
        "title": "Body text colour",
        "format": "color",
        "default": "#212529"
      },
      "--color-headings": {
        "type": "string",
        "title": "Headings colour",
        "format": "color",
        "default": "#000000"
      },
      "--color-primary": {
        "type": "string",
        "title": "Primary accent colour",
        "format": "color",
        "default": "#0d6efd"
      },

      "--font-headings": {
        "type": "string",
        "title": "Headings style",
        "description": "Choose the font family for all headlines.",
        "enum": [
          "var(--font-family-system-sans)",
          "var(--font-family-system-serif)",
          "var(--font-family-inter)",
          "var(--font-family-geist)",
          "var(--font-family-geist-mono)",
          "var(--font-family-special-gothic)",
          "var(--font-family-ibm-plex-sans)",
          "var(--font-family-ibm-plex-serif)",
          "var(--font-family-ibm-plex-mono)",
          "var(--font-family-instrument-serif)",
          "var(--font-family-instrument-sans)",
          "var(--font-family-gentium-book-plus)",
          "var(--font-family-playfair-display)"
        ],
        "enumNames": [
          "System sans",
          "System serif",
          "Inter",
          "Geist",
          "Geist Mono",
          "Special Gothic",
          "IBM Plex Sans",
          "IBM Plex Serif",
          "IBM Plex Mono",
          "Instrument Serif",
          "Instrument Sans",
          "Gentium Book Plus",
          "Playfair Display"
        ],
        "default": "var(--font-family-inter)"
      },

      "--font-body": {
        "type": "string",
        "title": "Body text style",
        "description": "Choose the font family for all paragraphs and lists.",
        "enum": [
          "var(--font-family-system-sans)",
          "var(--font-family-system-serif)",
          "var(--font-family-inter)",
          "var(--font-family-geist)",
          "var(--font-family-geist-mono)",
          "var(--font-family-special-gothic)",
          "var(--font-family-ibm-plex-sans)",
          "var(--font-family-ibm-plex-serif)",
          "var(--font-family-ibm-plex-mono)",
          "var(--font-family-instrument-serif)",
          "var(--font-family-instrument-sans)",
          "var(--font-family-gentium-book-plus)",
          "var(--font-family-playfair-display)"
        ],
        "enumNames": [
          "System sans",
          "System serif",
          "Inter",
          "Geist",
          "Geist Mono",
          "Special Gothic",
          "IBM Plex Sans",
          "IBM Plex Serif",
          "IBM Plex Mono",
          "Instrument Serif",
          "Instrument Sans",
          "Gentium Book Plus",
          "Playfair Display"
        ],
        "default": "var(--font-family-gentium-book-plus)"
      }
    }
  },
  "themeDataSchema": {
    "description": "Configure additional content fields for your site.",
    "type": "object",
    "properties": {
      "footer_content": {
        "type": "string",
        "title": "Footer content",
        "description": "Optional footer HTML content.",
        "format": "textarea",
        "default": "<p>&copy; 2024 Your Site Name. All rights reserved.</p>"
      },
      "header_content": {
        "type": "string", 
        "title": "Header content",
        "description": "Optional header HTML content.",
        "format": "textarea",
        "default": ""
      }
    }
  },
  "image_presets": {
    "social": {
      "width": 1200,
      "height": 630,
      "crop": "fill",
      "gravity": "center",
      "description": "Social media sharing image (Open Graph)"
    },
    "thumbnail": {
      "width": 600,
      "height": 400,
      "crop": "fill",
      "gravity": "center",
      "description": "Small thumbnail for cards and previews"
    },
    "banner": {
      "width": 800,
      "height": 256,
      "crop": "fill",
      "gravity": "center",
      "description": "Standard banner image for headers"
    },
    "hero": {
      "width": 1600,
      "height": 800,
      "crop": "fill",
      "gravity": "center",
      "description": "Large hero image for landing pages"
    }
  }
}
